{% extends "layout_public.html.twig" %}
{% set company = guest.system_company|default({}) %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Reset Password'|trans }}{% endblock %}
{% block meta_description %}{{ 'Request a password reset link to regain access to your client account securely.'|trans }}{% endblock %}

{% block body_class %}page-password-reset{% endblock %}
{% block body %}
    <div class="page page-center">
      <div class="container container-tight py-4">
        {% if settings.login_page_show_logo|default('') %}
            {% include 'partial_kovil_auth_brand.html.twig' %}
        {% endif %}
        <form class="api-form auth card card-md" method="post" action="{{ 'client/reset_password'|api_url(role='guest') }}" {{ fb_api_form({ message: 'A password reset confirmation email will be sent to you if we found an account with that email address.'|trans }) }}>
          <div class="card-body">
            <h1 class="auth-title text-center mb-4">{{ 'Reset your password'|trans }}</h1>
            <p class="text-secondary mb-4">{{ 'Enter your email to reset password. You will receive new password after reset link is confirmed.'|trans }}</p>
            <div class="mb-3">
              <label class="form-label" for="reset-email">{{ 'Email'|trans }}</label>
              <input type="email" id="reset-email" class="form-control" placeholder="{{ 'Enter your email address'|trans }}" name="email" value="{{ request.email }}" required="required" autofocus autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"/>
            </div>
            <div class="form-footer">
              {{ mf.recaptcha }}
              <button type="submit" class="btn btn-primary btn-4 w-100">
                <i class="ti ti-mail icon icon-2" aria-hidden="true"></i>
                {{ 'Reset password'|trans }}
              </button>
            </div>
          </div>
        </form>
        <div class="text-center text-secondary mt-3"><a href="{{ 'login'|url }}">{{ 'Back to login'|trans }}</a></div>
      </div>
    </div>
{% endblock %}