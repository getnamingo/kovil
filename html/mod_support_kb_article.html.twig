{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'kb' %}

{% block meta_title %}{{ article.title }}{% endblock %}

{% block meta_description %}
    {{ (article.content ?? '')|markdown_to_html|striptags|trim|truncate(160) }}
{% endblock %}

{% block page_header %}
    {{ article.title }}
{% endblock %}

{% block page_description %}
    {% if article.updated_at %}
        <span class="d-inline-flex align-items-center gap-1 me-3">
            <i class="ti ti-clock icon" aria-hidden="true"></i>
            {{ 'Updated'|trans }} {{ '%time% ago'|trans({'%time%': article.updated_at|timeago}) }}
        </span>
    {% endif %}
    {% if guest.support_kb_article_views_enabled %}
        <span class="d-inline-flex align-items-center gap-1">
            <i class="ti ti-eye icon" aria-hidden="true"></i>
            {{ article.views }} {{ 'views'|trans }}
        </span>
    {% endif %}
{% endblock %}

{% block body_class %}kb-article{% endblock %}

{% block head %}


    <style>
        .kb-article-content {
            font-size: 1rem;
            line-height: 1.75;
        }

        .kb-article-content > :first-child {
            margin-top: 0;
        }

        .kb-article-content > :last-child {
            margin-bottom: 0;
        }

        @media (min-width: 992px) {
            .kb-sidebar-sticky {
                position: sticky;
                top: calc(var(--page-padding-y, 1.5rem) + 1rem);
            }
        }
    </style>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <a href="{{ 'support/kb'|url }}">
            {{ 'Knowledge Base'|trans }}
        </a>
    </li>

    <li class="breadcrumb-item">
        <a href="{{ "support/kb/#{article.category.slug}"|url }}">
            {{ article.category.title }}
        </a>
    </li>

    <li class="breadcrumb-item active" aria-current="page">
        {{ article.title }}
    </li>
{% endblock %}

{% block content %}
    {% set related_articles = guest.support_kb_article_get_list({
        'kb_article_category_id': article.category.id,
        'per_page': 6
    }).list
        |filter(related_article => related_article.id != article.id)
        |slice(0, 5)
    %}

    <div class="row row-cards">
        <div class="col-lg-8 col-xl-9">
            <div class="card">
                <div class="card-body p-4 p-md-5">
                    <div class="markdown kb-article-content">
                        {{ (article.content ?? '')|markdown_to_html }}
                    </div>
                </div>

                <div class="card-footer">
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <a
                            href="{{ 'support/kb'|url }}"
                            class="btn btn-outline-secondary"
                        >
                            <i class="ti ti-arrow-left icon me-2" aria-hidden="true"></i>

                            {{ 'Browse all articles'|trans }}
                        </a>

                        <a
                            href="{{ "support/kb/#{article.category.slug}"|url }}"
                            class="btn btn-outline-secondary"
                        >
                            {{ 'More in this category'|trans }}

                            <i class="ti ti-arrow-right icon ms-2" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="card bg-primary-lt border-primary-subtle mt-4">
                <div class="card-body">
                    <div class="row align-items-center g-3">
                        <div class="col-auto">
                            <span class="avatar bg-primary text-white">
                                <i class="ti ti-message svg-icon" aria-hidden="true"></i>
                            </span>
                        </div>

                        <div class="col">
                            <h2 class="h3 mb-1">
                                {{ 'Still need help?'|trans }}
                            </h2>

                            <div class="text-secondary">
                                {{ 'If this article did not answer your question, our support team can help.'|trans }}
                            </div>
                        </div>

                        <div class="col-12 col-sm-auto">
                            <a
                                href="{{ 'support/contact-us'|url }}"
                                class="btn btn-primary w-100"
                            >
                                {{ 'Contact support'|trans }}

                                <i class="ti ti-arrow-right icon ms-2" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <aside class="col-lg-4 col-xl-3">
            <div class="kb-sidebar-sticky">
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="subheader mb-2">
                            {{ 'Category'|trans }}
                        </div>

                        <h2 class="card-title mb-3">
                            <a
                                href="{{ "support/kb/#{article.category.slug}"|url }}"
                                class="text-reset text-decoration-none"
                            >
                                {{ article.category.title }}
                            </a>
                        </h2>

                        <a
                            class="btn btn-outline-primary w-100"
                            href="{{ "support/kb/#{article.category.slug}"|url }}"
                        >
                            {{ 'View category'|trans }}
                        </a>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">
                            {{ 'Related articles'|trans }}
                        </h2>
                    </div>

                    {% if related_articles|length > 0 %}
                        <div class="list-group list-group-flush">
                            {% for related_article in related_articles %}
                                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-2 py-3"
                                   href="{{ "support/kb/#{related_article.category.slug}/#{related_article.slug}"|url }}">
                                    <span class="small fw-medium text-break">{{ related_article.title }}</span>
                                    <i class="ti ti-chevron-right icon text-secondary flex-shrink-0" aria-hidden="true"></i>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="card-body">
                            <div class="empty py-3">
                                <div class="empty-icon">
                                    <i class="ti ti-file-unknown icon" aria-hidden="true"></i>
                                </div>

                                <p class="empty-title">
                                    {{ 'No related articles yet.'|trans }}
                                </p>
                            </div>
                        </div>
                    {% endif %}

                    <div class="card-footer">
                        <a
                            class="btn btn-ghost-secondary w-100"
                            href="{{ 'support/kb'|url }}"
                        >
                            {{ 'Browse Knowledge Base'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </aside>
    </div>
{% endblock %}