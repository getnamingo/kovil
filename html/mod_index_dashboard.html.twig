{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'dashboard' %}
{% set cart_currency = guest.cart_get_currency %}

{% block meta_title %}{% if client %}{{ 'Dashboard'|trans }}{% else %}{{ 'Home'|trans }}{% endif %}{% endblock %}
{% block page_header %}{{ client ? 'Dashboard'|trans : 'Client Area'|trans }}{% endblock %}

{% block body_class %}dashboard{% endblock %}

{% import "macro_functions.html.twig" as mf %}

{% block content %}
    {{ render_widgets('client.index.dashboard.content.before') }}

    {% if settings.showcase_enabled|default('') %}
    <div class="row row-deck row-cards dashboard-intro mb-3">
       <div class="col-md-12">
          <div class="card card-sm">
             <div class="card-status-top bg-primary"></div>
             <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-center text-center text-md-start">
                <div class="mt-3">{{ settings.showcase_text|default('')|markdown_to_html }}</div>
                {% if (settings.showcase_button_url|default('')) and (settings.showcase_button_title|default('')) %}
                <a class="btn btn-primary" href="{{ settings.showcase_button_url|default('') }}">{{ settings.showcase_button_title|default('') }}</a>
                {% endif %}
             </div>
          </div>
       </div>
    </div>
    {% endif %}

    {% if client %}
        {% set dashboard = client.index_get_dashboard %}
        {% set profile = dashboard.profile %}

        {{ render_widgets('client.index.dashboard.client.before', { 'dashboard': dashboard, 'profile': profile }) }}

        {% set tickets = client.support_ticket_get_list({ "status": 'on_hold' }) %}
        {% if tickets.total > 0 %}
            <div class="row">
                <div class="col-md-12">
                    {% for i, ticket in tickets.list %}
                        <div class="alert alert-info d-flex justify-content-between" role="alert">
                            <span>Ticket <strong>#{{ ticket.id }}</strong> was replied to {{ ticket.updated_at|timeago }} {{ 'ago'|trans }}.</span><a
                                href="{{ 'support/ticket'|url }}/{{ ticket.id }}"
                                class="alert-link">{{ 'Reply'|trans }}</a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <div>
            <div class="row align-items-center mb-3">
              <div class="col">
                <h2 class="page-title">
                  <span class="d-none d-md-inline">
                    {{ 'Welcome'|trans }}, {{ profile.first_name }} {{ profile.last_name }}
                  </span>

                  <span class="d-md-none">
                    <span class="d-block">{{ 'Welcome'|trans }},</span>
                    <span class="d-block">{{ profile.first_name }} {{ profile.last_name }}</span>
                  </span>
                </h2>
              </div>
              {% if settings.sidebar_balance_enabled|default('1') and guest.invoice_funds_enabled %}
              <div class="col-auto ms-auto">
                <a href="{{ '/client/balance'|url }}" class="card card-link">
                  <div class="card-body py-2 px-3">
                    <div class="d-flex align-items-center gap-3">

                      <span class="text-secondary">
                        <i class="ti ti-wallet icon" aria-hidden="true"></i>
                      </span>

                      <div class="lh-sm">
                        <div class="text-muted small mb-1">
                          {{ 'Balance'|trans }}
                        </div>
                        <div class="fw-bold">
                          {{ profile.balance|format_currency((profile|default({})).currency|default(default_currency)) }}
                        </div>
                      </div>

                      <span class="ms-2 text-secondary">
                        <i class="ti ti-chevron-right icon" aria-hidden="true"></i>
                      </span>

                    </div>
                  </div>
                </a>
              </div>
              {% endif %}
            </div>
            {% set metrics = [
                {
                    title: 'Services'|trans, route: 'order/service', icon: 'stack-2', tone: 'success',
                    total: client.order_get_list({'hide_addons': 1}).total,
                    detail: client.order_get_list({'expiring': 1}).total ~ ' ' ~ ('Expiring'|trans)
                },
                {
                    title: 'Invoices'|trans, route: 'invoice', icon: 'receipt', tone: 'violet',
                    total: client.invoice_get_list().total,
                    detail: client.invoice_get_list({'status': 'unpaid'}).total ~ ' ' ~ ('Unpaid'|trans)
                },
                {
                    title: 'Tickets'|trans, route: 'support', icon: 'lifebuoy', tone: 'info',
                    total: client.support_ticket_get_list().total,
                    detail: client.support_ticket_get_list({'status': 'open'}).total ~ ' ' ~ ('Open'|trans)
                }
            ] %}
            <section class="dashboard-metrics mb-3" aria-label="{{ 'Account overview'|trans }}">
                {% for metric in metrics %}
                <a class="card card-link metric" href="{{ metric.route|url }}">
                    <div class="metric-head">
                        <h3>{{ metric.title }}</h3>
                        <span class="metric-icon tone-{{ metric.tone }}"><i class="ti ti-{{ metric.icon }}" aria-hidden="true"></i></span>
                    </div>
                    <p class="metric-value">{{ metric.total }}</p>
                    <p class="metric-note">{{ metric.detail }}</p>
                </a>
                {% endfor %}
            </section>
            <div class="row row-cards">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header py-3">
                          <div class="d-flex align-items-center justify-content-between w-100">
                            <h3 class="card-title mb-0"><span class="status-dot status-green"></span> {{ 'Recent Orders'|trans }}</h3>
                            <div class="btn-list">
                              <a href="{{ 'order/service'|url }}" class="btn btn-sm btn-outline-secondary">
                                {{ 'Orders'|trans }}
                              </a>
                              <a href="{{ 'order'|url }}" class="btn btn-sm btn-primary btn-animate-icon btn-animate-icon-rotate">
                                <i class="ti ti-plus icon" aria-hidden="true"></i>
                                {{ 'New order'|trans }}
                              </a>
                            </div>
                          </div>
                        </div>
                        {% if client.order_get_list({ "per_page": 5, "page": request.page, "hide_addons": 1 }).list %}
                        <div class="list-group list-group-flush">
                          {% for i, order in client.order_get_list({ "per_page": 5, "page": request.page, "hide_addons": 1 }).list %}
                            <a href="{{ 'order/service/manage'|url }}/{{ order.id }}" class="list-group-item py-3 list-group-item-action text-reset">
                              <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                  <span class="fw-bold">
                                    {{ order.title starts with 'Domain ' and (order.title ends with ' registration' or order.title ends with ' transfer') ? order.title|split(' ')[1] : order.title }}
                                  </span>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                  <div class="text-secondary small text-end">
                                    <div class="text-muted small">{{ 'Registered On'|trans }}</div>
                                    <div class="text-secondary fw-semibold">{{ order.activated_at|date('Y-m-d H:i:s') }}</div>
                                  </div>
                                  <span class="text-muted">
                                    <i class="ti ti-chevron-right icon" aria-hidden="true"></i>
                                  </span>
                                </div>
                              </div>
                            </a>
                          {% endfor %}
                        </div>
                        {% else %}
                            {{ include('partial_empty_state.html.twig', {
                                'title': 'No recent orders'|trans,
                                'description': 'You have no recent orders to display.'|trans
                            }) }}
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header py-3">
                          <div class="d-flex align-items-center justify-content-between w-100">
                            <h3 class="card-title mb-0">{{ 'Support Tickets'|trans }}</h3>
                            <div class="btn-list">
                              <a href="{{ 'support'|url }}" class="btn btn-sm btn-outline-secondary">
                                {{ 'Tickets'|trans }}
                              </a>
                              <a href="{{ 'support'|url({ 'ticket': 1 }) }}" class="btn btn-sm btn-primary btn-animate-icon btn-animate-icon-rotate">
                                <i class="ti ti-plus icon" aria-hidden="true"></i>
                                {{ 'New ticket'|trans }}
                              </a>
                            </div>
                          </div>
                        </div>
                        {% if client.support_ticket_get_list({ "per_page": 5 }).list %}
                        <div class="list-group list-group-flush">
                          {% for i, ticket in client.support_ticket_get_list({ "per_page": 5 }).list %}
                            <a href="{{ 'support/ticket'|url }}/{{ ticket.id }}" class="list-group-item py-3 list-group-item-action text-reset">
                              <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                  <span class="fw-bold">
                                    {{ ticket.subject|truncate(45) }}
                                  </span>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                  <div class="text-secondary small text-end">
                                    <div class="text-muted small">{{ 'Time Opened'|trans }}</div>
                                    <div class="text-secondary fw-semibold">{{ ticket.created_at|date('Y-m-d H:i:s') }}</div>
                                  </div>
                                  <span class="badge {% if ticket.status == 'open' %}bg-success text-success-fg{% elseif ticket.status == 'on_hold' %}bg-warning text-warning-fg{% elseif ticket.status == 'closed' %}bg-secondary text-secondary-fg{% endif %}">{{ mf.status_name(ticket.status) }}</span>
                                  <span class="text-muted">
                                    <i class="ti ti-chevron-right icon" aria-hidden="true"></i>
                                  </span>
                                </div>
                              </div>
                            </a>
                          {% endfor %}
                        </div>
                        {% else %}
                            {{ include('partial_empty_state.html.twig', {
                                'title': 'No recent support tickets'|trans,
                                'description': 'You have no recent support tickets to display.'|trans
                            }) }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {{ render_widgets('client.index.dashboard.client.after', { 'dashboard': dashboard, 'profile': profile }) }}

    {% else %}
        {% set domains_enabled = guest.extension_is_on({"mod":"domains"}) %}
        {% set domainProducts = guest.product_get_list({ "type": "domain" }) %}
        {% set registrar_mode = domains_enabled and domainProducts.list|length > 0 %}

        {% include 'custom/dashboard.top.twig' ignore missing %}
        {{ render_widgets('client.index.dashboard.guest.before') }}

        <div class="row row-cards">
            {% if domainProducts.list|length > 0 %}
            <div class="card card-borderless bg-primary-lt">
                <div class="card-body py-4" id="register">
                    {% if domains_enabled %}
                        <div class="text-center mb-4">
                            <h2 class="h1 mb-2">{{ 'Find your perfect domain name.'|trans }}</h2>
                            <p class="text-secondary mb-0">{{ 'Search, register, and manage your domains with ease.'|trans }}</p>
                        </div>
                    {% endif %}
                    <form id="domain-search-transfer-form" role="search">
                        <div class="row g-2{% if not domains_enabled %} mb-3{% endif %}">
                            <div class="col-12 col-md-10">
                                <label for="dashboard-domain-name" class="visually-hidden">{{ 'Domain name'|trans }}</label>
                                <input id="dashboard-domain-name" type="search" class="form-control form-control-lg" placeholder="example.com" name="domain_name" value="{{ request.domain_name }}" autocapitalize="none" autocomplete="off" spellcheck="false" inputmode="url" required>
                            </div>
                            <div class="col-12 col-md-2">
                                <button class="btn btn-primary btn-lg w-100" type="submit" id="domain-check"><i class="ti ti-search icon" aria-hidden="true"></i> {{ 'Search'|trans }}</button>
                            </div>
                        </div>
                        {% set domainProduct = (domainProducts.list|first) %}
                        {% set pricing = domainProduct.pricing ?? {} %}

                        {% if domains_enabled %}
                            {% set featured = pricing|filter(item => (item.active ?? 0) == 1 and (item.allow_register ?? 0) == 1)|sort((a, b) => a.tld <=> b.tld) %}
                            {% set strip_count = 5 %}
                            {% if guest.extension_is_on({'mod': 'domainx'}) %}
                                {% set presentation = guest.domainx_presentation %}
                                {% set strip_count = presentation.homepage_strip_count ?? 5 %}
                                {% if presentation.homepage_strip_order|default('alphabetical') == 'search' %}
                                    {% set positions = presentation.positions|default({}) %}
                                    {% set featured = featured|sort((a, b) => ((positions[a.tld] ?? 2147483647) <=> (positions[b.tld] ?? 2147483647)) ?: (a.tld <=> b.tld)) %}
                                {% endif %}
                            {% endif %}
                            {% set featured = featured|slice(0, strip_count) %}
                            <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 mt-3 small">
                                {% for item in featured %}
                                    {% if not loop.first %}<span class="text-secondary" aria-hidden="true">&middot;</span>{% endif %}
                                    <span>{{ item.tld }} <strong>{{ (item.price_registration * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong></span>
                                {% endfor %}
                                {% if featured|length > 0 %}<span class="text-secondary" aria-hidden="true">&middot;</span>{% endif %}
                                <a href="{{ 'domains'|url }}">{{ 'All extensions'|trans }} &rarr;</a>
                            </div>
                        {% else %}
                            <p class="text-muted text-center mt-4" id="info-text">Search for your perfect domain name.</p>
                            {% set chips = pricing
                              |filter(item => (item.active ?? 0) == 1)
                              |sort((a, b) => a.tld <=> b.tld)
                              |slice(0, 8)
                            %}

                            {% if chips|length > 0 %}
                              <div class="mt-4">
                                <div class="d-flex flex-wrap gap-3 justify-content-center">
                                  {% set colors = ['azure', 'indigo', 'purple', 'pink', 'teal', 'green', 'orange'] %}
                                  {% for item in chips %}
                                    {% set color = colors[loop.index0 % colors|length] %}
                                    <div class="btn btn-light" style="pointer-events:none;">
                                      <span class="fw-bold" style="letter-spacing:-0.01em;">{{ item.tld }}</span>
                                      <span class="badge bg-{{ color }} text-{{ color }}-fg ms-2">
                                        {{ ((item.price_registration) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                                      </span>
                                    </div>
                                  {% endfor %}
                                </div>
                              </div>
                            {% endif %}
                        {% endif %}
                    </form>
                </div>
            </div>
            {% endif %}

            {% include 'custom/dashboard.widgets.twig' ignore missing %}

            <div class="col-12 col-md-4 d-flex">
                <div class="card w-100">
                    <div class="card-body">
                        <div class="mb-3 text-primary">
                            <i class="ti ti-arrows-right-left" aria-hidden="true"></i>
                        </div>
                        {% if registrar_mode %}
                            <h3 class="card-title mb-2">{{ 'Domain transfers'|trans }}</h3>
                            <p class="text-secondary mb-0">{{ 'Already own a domain? Bring it together with your new registrations.'|trans }}</p>
                        {% else %}
                            <h3 class="card-title mb-2">{{ 'Explore services'|trans }}</h3>
                            <p class="text-secondary mb-0">{{ 'Find the products and services available from this provider.'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4 d-flex">
                <div class="card w-100">
                    <div class="card-body">
                        <div class="mb-3 text-primary">
                            <i class="ti ti-layout-dashboard icon" aria-hidden="true"></i>
                        </div>
                        {% if registrar_mode %}
                            <h3 class="card-title mb-2">{{ 'Domain management'|trans }}</h3>
                            <p class="text-secondary mb-0">{{ 'Keep your domains, nameservers, and contact details organized in one place.'|trans }}</p>
                        {% else %}
                            <h3 class="card-title mb-2">{{ 'One customer dashboard'|trans }}</h3>
                            <p class="text-secondary mb-0">{{ 'Manage your orders, services, and account details in one place.'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4 d-flex">
                <div class="card w-100">
                    <div class="card-body">
                        <div class="mb-3 text-primary">
                            <i class="ti ti-receipt" aria-hidden="true"></i>
                        </div>
                        {% if registrar_mode %}
                            <h3 class="card-title mb-2">{{ 'Renewals and billing'|trans }}</h3>
                            <p class="text-secondary mb-0">{{ 'Follow your domain renewals and review invoices from your account.'|trans }}</p>
                        {% else %}
                            <h3 class="card-title mb-2">{{ 'Billing made simple'|trans }}</h3>
                            <p class="text-secondary mb-0">{{ 'Review invoices, payments, and service information in your account.'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            {% if guest.extension_is_on({"mod":"news"}) or guest.support_kb_enabled() %}
                <div class="col-12">
                    <div class="d-flex flex-wrap justify-content-center gap-4 small pt-1">
                        {% if guest.extension_is_on({"mod":"news"}) %}
                            <a href="{{ '/news'|url }}">{{ 'Announcements'|trans }} &rarr;</a>
                        {% endif %}
                        {% if guest.support_kb_enabled() %}
                            <a href="{{ '/support/kb'|url }}">{{ 'Knowledge Base'|trans }} &rarr;</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>

        {% include 'custom/dashboard.bottom.twig' ignore missing %}

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        const input = document.querySelector('input[name="domain_name"]');
        const form  = document.getElementById("domain-search-transfer-form");

        if (!input || !form) return;

        function handleSubmit() {

            const domain = input.value.trim();

            if (!domain) {
                FOSSBilling.message("Please enter a domain name");
                return;
            }

            sessionStorage.setItem("namingo_domain", domain);

            window.location.href = "/order";
        }

        form.addEventListener("submit", function (e) {
            e.preventDefault();
            handleSubmit();
        });

    });
    </script>

        {{ render_widgets('client.index.dashboard.guest.after') }}
    {% endif %}

    {{ render_widgets('client.index.dashboard.content.after') }}
{% endblock %}
