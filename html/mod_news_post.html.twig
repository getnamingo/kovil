{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'news' %}

{% set display_date = post.updated_at|default(post.published_at|default(null), true) %}

{% set summary_source = post.description|default('', true) %}
{% if not summary_source %}
    {% set summary_source = post.excerpt|default('', true) %}
{% endif %}
{% if not summary_source %}
    {% set summary_source = post.content|default('') %}
{% endif %}
{% set summary = summary_source|markdown_to_html|striptags|trim|truncate(160) %}

{% block meta_title %}{{ post.title }}{% endblock %}

{% block meta_description %}
    {{ summary }}
{% endblock %}

{% block page_header %}
    {{ post.title }}
{% endblock %}

{% block page_description %}
    {% if display_date %}
        <span class="d-inline-flex align-items-center gap-1 me-3">
            <i class="ti ti-calendar-event icon" aria-hidden="true"></i>
            {{ display_date|format_datetime }}
        </span>
    {% endif %}

    {% if post.author.name|default('') %}
        <span class="d-inline-flex align-items-center gap-1">
            <i class="ti ti-user icon" aria-hidden="true"></i>
            {{ 'by'|trans }} {{ post.author.name }}
        </span>
    {% endif %}
{% endblock %}

{% block body_class %}news-post{% endblock %}

{% block head %}

{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <a href="{{ 'news'|url }}">
            {{ 'Announcements'|trans }}
        </a>
    </li>

    <li class="breadcrumb-item active" aria-current="page">
        {{ post.title }}
    </li>
{% endblock %}

{% block opengraph %}
    <meta property="og:title" content="{{ post.title }}" />
    <meta property="og:type" content="article" />
    <meta property="og:description" content="{{ summary }}" />
    <meta property="og:url" content="{{ guest.system_current_url }}" />

    {% if post.image|default('') %}
        <meta property="og:image" content="{{ post.image }}" />
    {% endif %}

    {% if post.author.name|default('') %}
        <meta property="article:author" content="{{ post.author.name }}" />
    {% endif %}

    {% if post.published_at %}
        <meta property="article:published_time" content="{{ post.published_at|date('c') }}" />
    {% endif %}

    {% if post.updated_at %}
        <meta property="article:modified_time" content="{{ post.updated_at|date('c') }}" />
    {% endif %}

    {% if post.expires_at %}
        <meta property="article:expiration_time" content="{{ post.expires_at|date('c') }}" />
    {% endif %}

    {% if post.section %}
        <meta property="article:section" content="{{ post.section }}" />
    {% endif %}

    {% set tags = post.tags|default([]) %}
    {% for tag in tags %}
        <meta property="article:tag" content="{{ tag }}" />
    {% endfor %}
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-9 mx-auto">

            <article class="card mb-4">
                <div class="card-status-top bg-primary"></div>

                {% if post.image|default('') %}
                    <img
                        src="{{ post.image }}"
                        alt="{{ post.title }}"
                        class="img-fluid w-100"
                    >
                {% endif %}

                <div class="card-body p-4 p-md-5">
                    <div class="markdown">
                        {{ (post.content ?? '')|markdown_to_html }}
                    </div>
                </div>

                {% if guest.extension_is_on({"mod": "comment"}) %}
                    <div class="card-body border-top">
                        {{ include('mod_comment_block.html.twig') }}
                    </div>
                {% endif %}

                <div class="card-footer">
                    <a href="{{ 'news'|url }}"
                       class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left icon" aria-hidden="true"></i>
                        {{ 'Back to the list'|trans }}
                    </a>
                </div>
            </article>

        </div>
    </div>
{% endblock %}